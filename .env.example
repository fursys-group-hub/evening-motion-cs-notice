# ─────────────────────────────────────────────────────────────
# evening-motion-cs-notice 환경 변수 (Coolify 등록용 예시)
# ─────────────────────────────────────────────────────────────
#
# 변수명 규칙: <서비스>_<리소스>_<상세>   예: FURSYS_DB_PASSWORD
#
# ⚠️  보안 주의
#   - NEXT_PUBLIC_* 로 시작하는 변수는 브라우저로 그대로 노출됩니다.
#     비밀번호/API Key/토큰 같은 시크릿은 절대 NEXT_PUBLIC_* 에 넣지 마세요.
#   - 시크릿은 prefix 없이 등록하고, pages/api/* 안에서만 사용하세요.
#     (서버에서만 실행되므로 안전합니다)
#
# ─────────────────────────────────────────────────────────────

# ── 브라우저에 노출돼도 되는 값 (Build-time, NEXT_PUBLIC_*) ──
NEXT_PUBLIC_APP_NAME=evening-motion-cs-notice

# ── 서버에서만 사용하는 값 (Runtime, 시크릿 가능) ──
# 예시 — 실제 값은 Coolify Environment Variables 탭에 등록 (Locked=Yes)
# FURSYS_DB_HOST=
# FURSYS_DB_PASSWORD=
# FURSYS_BACKEND_API_BASE_URL=
# FURSYS_BACKEND_API_TOKEN=

# ── fgdw (사내 MSSQL Data Warehouse) 접속 ──────────────────────
# 서버사이드 전용. src/lib/fgdw.ts 가 이 값들을 읽습니다(브라우저 노출 X).
#
# 로컬 개발: FGDW_DB_USER / FGDW_DB_PASSWORD 에 "본인 fgdw 개발 계정" 을 넣으세요.
# 배포 시: 중앙 배포 프록시가 USER/PASSWORD 를 사내 공용 시스템계정으로 강제 치환하고
#          HOST/NAME 을 정규화합니다 → 실무자는 공용 비번을 몰라도 됩니다.
# 실제 비밀번호를 repo 에 커밋하지 마세요(.env 는 gitignore, .env.example 만 커밋).
FGDW_DB_HOST=192.9.201.23
FGDW_DB_PORT=1672
FGDW_DB_NAME=fgdw
FGDW_DB_USER=
FGDW_DB_PASSWORD=
